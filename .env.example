# ============================================================
# 365mc 검색 점유율 분석 — 환경변수 예제
# 실제 비밀값은 이 파일에 넣지 말고 .env로 복사해서 사용하세요.
# ============================================================

# ---- 서버 (server/.env 로 복사) ----

# PostgreSQL 접속 문자열. 다른 호스팅(RDS, Supabase, Railway, 자체 서버 등)으로
# 옮길 때는 이 값만 바꾸면 됩니다.
DATABASE_URL="postgresql://app:app_dev_password@localhost:5432/keyword_share?schema=public"

# JWT 서명 비밀키. 반드시 32자 이상의 무작위 문자열로 교체하세요.
# 생성 예: openssl rand -hex 32
JWT_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_SECRET"

# Access Token 만료 시간
JWT_EXPIRES_IN="8h"

# 서버 포트
PORT=4000

# 프런트엔드 오리진 (CORS 허용). 배포 도메인으로 교체하세요.
WEB_ORIGIN="http://localhost:5173"

# 업로드 파일 저장 경로 (로컬 디스크 기준). S3 등으로 교체 가능하도록
# server/src/lib/storage.ts 에서 어댑터로 분리되어 있습니다.
UPLOAD_DIR="./uploads"

# 업로드 제한 (명세 6절 초기 기준)
MAX_UPLOAD_MB=25
MAX_UPLOAD_MEGAPIXELS=100

# 공개 시연 모드 스위치. true면 /api/public/* 데모 엔드포인트가 격리된
# 시연 데이터만 제공하고, 운영 팀 DB에는 어떤 쓰기도 발생하지 않습니다.
PUBLIC_DEMO_ENABLED=true

# ---- 유료 OCR 확장 (선택, 기본 비활성) ----
# 아래 값이 비어 있으면 유료 OCR 경로는 서버에서 강제로 비활성화됩니다.
# 사용자 승인 없이 이 값을 채우거나 활성화하지 마세요.
PAID_OCR_PROVIDER=""
PAID_OCR_API_KEY=""
PAID_OCR_MONTHLY_BUDGET_KRW=""

# ---- 프런트엔드 (web/.env 로 복사) ----
VITE_API_BASE_URL="http://localhost:4000/api"
